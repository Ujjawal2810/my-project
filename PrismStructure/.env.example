# Copy to .env and fill in — never commit .env
BASE_URL=https://practicesoftwaretesting.com
API_BASE_URL=https://api.practicesoftwaretesting.com

TEST_USER_EMAIL=customer@practicesoftwaretesting.com
TEST_USER_PASSWORD=<your-demo-password>

TEST_USER2_EMAIL=customer2@practicesoftwaretesting.com
TEST_USER2_PASSWORD=<your-demo-password>

TEST_USER3_EMAIL=customer3@practicesoftwaretesting.com
TEST_USER3_PASSWORD=<your-demo-password>

# Registration UI/API tests — must satisfy Toolshop password rules (length, upper, lower, digit, symbol)
REGISTRATION_PASSWORD=<registration-password-meeting-toolshop-rules>

# Negative login tests — any value that does not match TEST_USER_EMAIL
INVALID_TEST_PASSWORD=<wrong-password-for-negative-tests>
